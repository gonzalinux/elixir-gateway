# ElixirGateway Environment Variables
# Copy to .env and update values for your environment
# See docs/ENVIRONMENT_VARIABLES.md for complete documentation

# Application (Required for production)
SECRET_KEY_BASE="generate-with-mix-phx-gen-secret"

# Gateway Services (optional - overrides config files)
# GATEWAY_SERVICES="api.example.com=>http://localhost:8080;app.example.com=>https://192.168.1.10:3000;default=>http://localhost:8000"
# Format: host=>target_url separated by semicolons
# Use "default" or "default_any" as fallback for unmatched hosts

# SSL/TLS - Let's Encrypt (recommended for production)
LETSENCRYPT_DOMAINS="api.yourdomain.com,service1.yourdomain.com"
LETSENCRYPT_EMAIL="admin@yourdomain.com"
# LETSENCRYPT_STAGING="true"  # Use Let's Encrypt staging for testing

# SSL/TLS - Certificate storage
# SITE_ENCRYPT_DB="/opt/elixir_gateway/certs"  # Certificate storage path
# ACME_SERVER_PORT="4005"                      # Internal ACME server port (dev/test only, default: 4005)

# Network Configuration
# PHX_HOST="0.0.0.0"      # Host to bind to (default: 0.0.0.0)
# HTTP_PORT="4000"        # HTTP port for ACME challenges (default: 4004 dev, 4000 prod)
# HTTPS_PORT="4001"       # HTTPS port for secure traffic (default: 4003 dev, 4001 prod)

# Metrics Authentication (optional)
# METRICS_AUTH_TOKEN="generate-with-mix-phx-gen-secret"  # Bearer token for /metrics endpoint
                                                          # If not set, uses IP-based auth (private networks only)

# Rate Limiting (optional)
# RATE_LIMIT_USER="100"      # Max requests per minute per user (default: 100)
# RATE_LIMIT_IP="500"        # Max requests per minute per IP (default: 500)

# Bot Blocker (optional)
# BOT_BLOCKER_ENABLED="true"       # Enable bot/scanner blocking (default: true)
# BOT_BLOCK_DURATION="3600"        # Block duration in seconds (default: 3600 = 1 hour)

# Clustering (optional - for high availability)
# CLUSTER_ENABLED="true"                    # Enable clustering (default: false)
# CLUSTER_SECRET="your-64-char-hex-secret"  # Generate with: mix elixir_gateway.gen.cluster_secret
# NODE_NAME="gateway-a"                     # Unique name for this node
# NODE_IP="203.0.113.10"                    # Optional: Override IP auto-detection
# CLUSTER_PORT="9100"                       # Port for cluster communication (default: 9100)
# CLUSTER_PEERS="gateway-b.example.com:9100"  # Comma-separated list of peer addresses
# IS_PRIMARY="true"                         # Optional: Explicitly set as primary (cert generator)
                                             # Auto-detected: empty CLUSTER_PEERS = primary
                                             # non-empty CLUSTER_PEERS = secondary
# CERT_SYNC_ENABLED="true"                  # Enable certificate sync (default: true)

# DNS Failover (optional - requires clustering enabled)
# DNS_FAILOVER_ENABLED="true"               # Enable automatic DNS updates on failover
# DNS_FAILOVER_TIMEOUT="5"                  # Seconds to wait before triggering failover (default: 5)
# DDNS_DOMAINS="@:example.com:pass1,api:example.com:pass2"  # Format: host:domain:password
# PUBLIC_IP_STATIC="203.0.113.10"           # Optional: Use static IP instead of auto-detect

# Load Distribution (optional - requires clustering enabled)
# LOAD_DISTRIBUTION_ENABLED="true"          # Enable active-active load distribution (default: false)
# NODE_WEIGHT="70"                          # This node's capacity weight (default: 70)
#                                           # Each node declares its own weight based on capacity
#                                           # Nodes auto-share weights when connecting via RPC
#                                           # Examples: 70 (high), 30 (medium), 15 (low)
# MIN_REQ_THRESHOLD="20"                    # Minimum requests/min before distribution starts (default: 20)
#                                           # Below this threshold, all traffic stays local

# DNS Discovery (optional - for Kubernetes)
# DNS_CLUSTER_QUERY="elixirgateway.default.svc.cluster.local"  # Kubernetes service discovery
