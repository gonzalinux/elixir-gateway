# ElixirGateway Environment Variables
# Copy to .env and update values for your environment
# See docs/ENVIRONMENT_VARIABLES.md for complete documentation

# Application (Required for production)
SECRET_KEY_BASE="generate-with-mix-phx-gen-secret"

# SSL/TLS - Let's Encrypt (recommended for production)
LETSENCRYPT_DOMAINS="api.yourdomain.com,service1.yourdomain.com"
LETSENCRYPT_EMAIL="admin@yourdomain.com"
# LETSENCRYPT_STAGING="true"  # Use Let's Encrypt staging for testing

# SSL/TLS - Certificate storage
# SITE_ENCRYPT_DB="/opt/elixir_gateway/certs"  # Certificate storage path
# CERT_DB_FOLDER="/etc/elixirgateway/certs"    # Alternative cert storage (prod)

# Network Configuration
# PHX_SERVER="true"        # Auto-start server (recommended for production)
# PHX_HOST="0.0.0.0"      # Host to bind to (default: 0.0.0.0)  
# PORT="4442"             # HTTP port (default: 4442)

# Partisan Clustering (optional - for high availability)
# CLUSTER_ENABLED="true"                    # Enable clustering (default: false)
# CLUSTER_SECRET="your-64-char-hex-secret"  # Generate with: mix elixir_gateway.gen.cluster_secret
# NODE_NAME="gateway-a"                     # Unique name for this node
# NODE_IP="203.0.113.10"                    # Optional: Override IP auto-detection
# CLUSTER_PORT="9100"                       # Port for cluster communication (default: 9100)
# CLUSTER_PEERS="gateway-b.example.com:9100"  # Comma-separated list of peer addresses

# DNS Failover (optional - requires clustering enabled)
# DNS_FAILOVER_ENABLED="true"               # Enable automatic DNS updates on failover
# DDNS_PASS_EXAMPLE_COM="your-ddns-password"  # Namecheap DDNS password for example.com
# PUBLIC_IP_STATIC="203.0.113.10"           # Optional: Use static IP instead of auto-detect
# DDNS_DOMAINS="@:example.com:pass1,api:example.com:pass2"  # Format: host:domain:password

# DNS Discovery (optional - for Kubernetes)
# DNS_CLUSTER_QUERY="elixirgateway.default.svc.cluster.local"  # Kubernetes service discovery
