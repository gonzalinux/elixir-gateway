// Grafana Alloy config — tails JSON logs from elixir-gateway and forwards to a Loki-compatible aggregator

local.file_match "gateway" {
  path_targets = [{"__path__" = "/app/logs/app.json.log"}]
}

loki.source.file "gateway" {
  targets    = local.file_match.gateway.targets
  forward_to = [loki.process.gateway.receiver]
}

loki.process "gateway" {
  // Parse the JSON line — top-level and nested metadata fields
  stage.json {
    expressions = {
      level      = "level",
      node       = "node",
      timestamp  = "timestamp",
      message    = "message",
      request_id = "metadata.request_id",
      module     = "metadata.module",
      function   = "metadata.function",
      line       = "metadata.line",
    }
  }

  // Promote level and node as indexed stream labels
  stage.labels {
    values = {
      level = null,
      node  = null,
    }
  }

  // Static labels applied to all log lines
  stage.static_labels {
    values = {
      app    = "elixir-gateway",
      deploy = coalesce(env("DEPLOY_ENV"), "local"),
    }
  }

  // Attach high-cardinality fields as structured metadata (queryable but not indexed)
  stage.structured_metadata {
    values = {
      request_id = "",
      module     = "",
      function   = "",
      line       = "",
    }
  }

  // Use the log's own timestamp instead of ingestion time
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }

  // Use message as the log line (_msg)
  stage.output {
    source = "message"
  }

  forward_to = [loki.write.aggregator.receiver]
}

loki.write "aggregator" {
  endpoint {
    url = coalesce(env("LOG_AGGREGATOR_URL"), "")
  }
}
